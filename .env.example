# Application Environment Variables
ENVIRONMENT=production
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET_KEY=super-secret-enterprise-jwt-key-32bytes-minimum!
JWT_ALGORITHM=HS256
JWT_ISSUER=https://auth.enterprise.internal
JWT_AUDIENCE=context-router-api
ENABLE_MTLS_VERIFICATION=false

# L2 Redis Cache
REDIS_PRIMARY_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT_SECONDS=2.0

# Downstream Service Contracts
POLICY_ENGINE_HOST=policy.internal
POLICY_ENGINE_PORT=50051
MEMORY_MANAGER_HOST=memory.internal
MEMORY_MANAGER_PORT=50052
TOKEN_BUDGET_HOST=budget.internal
TOKEN_BUDGET_PORT=8081
CONTEXT_ASSEMBLER_HOST=assembler.internal
CONTEXT_ASSEMBLER_PORT=8082
AUDIT_SERVICE_HOST=audit.internal
AUDIT_SERVICE_PORT=9092

# Routing & Resiliency
MAX_ROUTING_TIMEOUT_MS=15
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
